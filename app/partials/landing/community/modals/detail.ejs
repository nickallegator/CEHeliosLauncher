<div id="schematicsDetail" class="schematicsModalRoot communityDialogRoot" aria-hidden="true">
    <div id="schematicsDetailScrim" class="schematicsModalScrim"></div>
    <div id="schematicsDetailPanel" class="schematicsModalPanel communityDialogPanel communitySchematicDetailPanel" role="dialog" aria-modal="true" aria-labelledby="schematicsDetailTitle" tabindex="-1">
        <header id="schematicsDetailHeader" class="communityDialogHeader">
            <div id="schematicsDetailHeading" class="communityDialogHeading">
                <div id="schematicsDetailEyebrow"><%- lang('landing.schematicsDetailEyebrow') %></div>
                <h2 id="schematicsDetailTitle"><%- lang('community.schematic') %></h2>
                <div id="schematicsDetailCreator"><%- lang('community.byUnknown') %></div>
            </div>
            <button id="schematicsDetailClose" type="button" class="schematicsDetailButton"><%- lang('landing.schematicsDetailClose') %></button>
        </header>
        <main id="schematicsDetailBody" class="communityDialogMain">
            <section id="schematicsDetailPreview" aria-label="<%- lang('landing.schematicsDetailPreviewLabel') %>">
                <canvas id="schematicsDetailCanvas" aria-label="<%- lang('landing.schematicsDetailPreviewLabel') %>"></canvas>
                <svg id="schematicsDetailPreviewIcon" viewBox="0 0 48 48" aria-hidden="true" focusable="false" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M24 6 8 14v20l16 8 16-8V14L24 6z"/>
                    <path d="M8 14l16 8 16-8"/>
                    <path d="M24 22v20"/>
                </svg>
                <div class="schematicMeshOverlay" aria-hidden="true">
                    <div class="schematicMeshSpinner"></div>
                    <div class="schematicMeshLabel"><%- lang('community.buildingMesh') %></div>
                </div>
            </section>
            <aside id="schematicsDetailInfo" aria-label="<%- lang('community.details') %>">
                <div class="schematicsDetailInfoGrid">
                    <section id="schematicsDetailBlocks">
                        <div class="schematicsDetailBlockHeader">
                            <span class="schematicsDetailBlockTitle"><%- lang('landing.schematicsDetailBlocksTitle') %></span>
                            <span id="schematicsDetailBlocksTotal" class="schematicsDetailBlockTotal">--</span>
                        </div>
                        <div id="schematicsDetailBlocksList" class="schematicsDetailBlockList"></div>
                    </section>
                    <section id="schematicsDetailMods">
                        <div class="schematicsDetailModHeader">
                            <span class="schematicsDetailModTitle"><%- lang('landing.schematicsDetailModsTitle') %></span>
                            <span id="schematicsDetailModsTotal" class="schematicsDetailModTotal">--</span>
                        </div>
                        <div id="schematicsDetailModsList" class="schematicsDetailModList"></div>
                    </section>
                </div>
                <section id="schematicsDetailStats">
                    <div class="schematicsDetailInfoTitle"><%- lang('community.details') %></div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailRelease') %></span>
                        <span id="schematicsDetailRelease" class="schematicsDetailStatValue">--</span>
                    </div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailSize') %></span>
                        <span id="schematicsDetailSize" class="schematicsDetailStatValue">--</span>
                    </div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailDownloads') %></span>
                        <span id="schematicsDetailDownloads" class="schematicsDetailStatValue">--</span>
                    </div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailLikes') %></span>
                        <span id="schematicsDetailLikes" class="schematicsDetailStatValue">--</span>
                    </div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailViews') %></span>
                        <span id="schematicsDetailViews" class="schematicsDetailStatValue">--</span>
                    </div>
                    <div class="schematicsDetailStat">
                        <span class="schematicsDetailStatLabel"><%- lang('landing.schematicsDetailVersion') %></span>
                        <span id="schematicsDetailVersion" class="schematicsDetailStatValue">--</span>
                    </div>
                </section>
                <p id="schematicsDetailDescription"></p>
                <div id="schematicsDetailTags"></div>
            </aside>
        </main>
        <footer id="schematicsDetailActions" class="communityDialogFooter">
            <button id="schematicsDetailInstall" type="button" class="schematicsDetailButton primary"><%- lang('landing.schematicsDetailInstall') %></button>
            <button id="schematicsDetailRemove" type="button" class="schematicsDetailButton"><%- lang('landing.schematicsDetailRemove') %></button>
            <button id="schematicsDetailAddToCollection" type="button" class="schematicsDetailButton" data-community-deferred="collections" hidden><%- lang('community.addToCollection') %></button>
            <button id="schematicsDetailLike" type="button" class="schematicsDetailButton"><%- lang('community.like') %></button>
            <div class="schematicsDetailShareAction">
                <button id="schematicsDetailShareButton" type="button" class="schematicsDetailButton" aria-haspopup="menu" aria-expanded="false" aria-controls="schematicsDetailShareMenu"><%- lang('landing.schematicsDetailShare') %></button>
                <div id="schematicsDetailShareMenu" class="schematicsDetailShareMenu" role="menu" aria-label="<%- lang('landing.schematicsDetailShareMenuTitle') %>" hidden>
                    <div class="schematicsDetailShareMenuHead">
                        <span class="schematicsDetailShareMenuTitle"><%- lang('landing.schematicsDetailShareMenuTitle') %></span>
                        <span id="schematicsDetailShareMenuSubtitle" class="schematicsDetailShareMenuSubtitle" data-default="<%- lang('landing.schematicsDetailShareMenuSubtitle') %>"><%- lang('landing.schematicsDetailShareMenuSubtitle') %></span>
                    </div>
                    <div class="schematicsDetailShareOptions">
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="copy-link" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionCopy') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="discord" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionDiscord') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="x" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionX') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="reddit" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionReddit') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="facebook" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionFacebook') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                        <button type="button" class="schematicsDetailShareOption" data-schematic-share-option="email" role="menuitem"><span><%- lang('landing.schematicsDetailShareOptionEmail') %></span><span class="schematicsDetailShareOptionStatus"><%- lang('community.soon') %></span></button>
                    </div>
                </div>
            </div>
            <button id="schematicsDetailEdit" type="button" class="schematicsDetailButton"><%- lang('community.edit') %></button>
            <button id="schematicsDetailDelete" type="button" class="schematicsDetailButton"><%- lang('community.delete') %></button>
            <button id="schematicsDetailReport" type="button" class="schematicsDetailButton"><%- lang('community.report') %></button>
        </footer>
    </div>
</div>
