<div id="schematicsEdit" class="schematicsModalRoot" aria-hidden="true">
    <div id="schematicsEditScrim" class="schematicsModalScrim"></div>
    <div id="schematicsEditPanel" class="schematicsModalPanel" role="dialog" aria-modal="true" aria-labelledby="schematicsEditTitle" tabindex="-1">
        <div id="schematicsEditHeader">
            <div id="schematicsEditHeading">
                <div id="schematicsEditEyebrow"><%- lang('community.creatorTools') %></div>
                <h2 id="schematicsEditTitle"><%- lang('community.editSchematic') %></h2>
                <div id="schematicsEditSubtitle"><%- lang('community.editSubtitle') %></div>
            </div>
            <div id="schematicsEditActions">
                <button id="schematicsEditClose" type="button" class="schematicsDetailButton"><%- lang('community.close') %></button>
            </div>
        </div>
        <div id="schematicsEditBody">
            <div id="schematicsEditMeta">
                <div class="schematicsUploadSection">
                    <div class="schematicsUploadSectionTitle"><%- lang('community.details') %></div>
                    <label class="schematicsUploadField">
                        <span><%- lang('community.fieldTitle') %></span>
                        <input id="schematicsEditNameInput" type="text" maxlength="80" />
                    </label>
                    <label class="schematicsUploadField">
                        <span><%- lang('community.description') %></span>
                        <textarea id="schematicsEditDescriptionInput" maxlength="800"></textarea>
                    </label>
                    <label class="schematicsUploadField">
                        <span><%- lang('community.tags') %></span>
                        <input id="schematicsEditTagsInput" type="text" placeholder="<%- lang('community.tagsExample') %>" />
                    </label>
                    <label class="schematicsUploadField">
                        <span><%- lang('community.visibility') %></span>
                        <select id="schematicsEditVisibility">
                            <option value="public"><%- lang('community.public') %></option>
                        </select>
                    </label>
                    <label class="schematicsUploadField">
                        <span><%- lang('community.version') %></span>
                        <input id="schematicsEditVersionInput" type="text" />
                    </label>
                    <div id="schematicsEditStatus"><%- lang('community.readyToEdit') %></div>
                    <div id="schematicsEditSubmitRow">
                        <button id="schematicsEditSubmit" type="button" class="schematicsDetailButton primary"><%- lang('community.saveChanges') %></button>
                        <button id="schematicsEditRevision" type="button" class="schematicsDetailButton"><%- lang('community.uploadRevision') %></button>
                        <button id="schematicsEditCancel" type="button" class="schematicsDetailButton"><%- lang('community.cancel') %></button>
                    </div>
                </div>
                <div class="schematicsUploadSection schematicsUploadPreviewSection">
                    <div class="schematicsUploadSectionTitle"><%- lang('community.preview') %></div>
                    <div id="schematicsEditPreview">
                        <img id="schematicsEditPreviewImage" alt="<%- lang('community.previewLabel') %>" hidden />
                        <svg class="schematicsUploadPreviewIcon" viewBox="0 0 48 48" aria-hidden="true" focusable="false" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M24 6 8 14v20l16 8 16-8V14L24 6z"/>
                            <path d="M8 14l16 8 16-8"/>
                            <path d="M24 22v20"/>
                        </svg>
                    </div>
                    <div class="schematicsUploadStats">
                        <div class="schematicsUploadStat">
                            <span class="schematicsUploadStatLabel"><%- lang('community.creator') %></span>
                            <span id="schematicsEditCreatorValue" class="schematicsUploadStatValue">--</span>
                        </div>
                        <div class="schematicsUploadStat">
                            <span class="schematicsUploadStatLabel"><%- lang('community.release') %></span>
                            <span id="schematicsEditReleaseValue" class="schematicsUploadStatValue">--</span>
                        </div>
                        <div class="schematicsUploadStat">
                            <span class="schematicsUploadStatLabel"><%- lang('community.downloads') %></span>
                            <span id="schematicsEditDownloadsValue" class="schematicsUploadStatValue">--</span>
                        </div>
                        <div class="schematicsUploadStat">
                            <span class="schematicsUploadStatLabel"><%- lang('community.likes') %></span>
                            <span id="schematicsEditLikesValue" class="schematicsUploadStatValue">--</span>
                        </div>
                        <div class="schematicsUploadStat">
                            <span class="schematicsUploadStatLabel"><%- lang('community.views') %></span>
                            <span id="schematicsEditViewsValue" class="schematicsUploadStatValue">--</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
