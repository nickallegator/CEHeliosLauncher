<div id="schematicsContainer">
        <div id="schematicsContent">
            <div id="schematicsHeader">
                <div id="schematicsTitleGroup">
                    <div id="schematicsEyebrow"><%- lang('landing.schematicsEyebrow') %></div>
                    <div id="schematicsTitle"><%- lang('landing.schematicsTitle') %></div>
                    <div id="schematicsSubtitle"><%- lang('landing.schematicsSubtitle') %></div>
                </div>
            </div>
            <div id="schematicsActionGroup">
                <div id="schematicsControlsRow">
                    <div id="schematicsCategoryRow" class="schematicsCategoryRow">
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('landing.schematicsCategoryLabel') %></span>
                            <select id="schematicsCategorySelect" aria-label="<%- lang('landing.schematicsCategoryLabel') %>">
                                <option value="schematics"><%- lang('community.schematicsTitle') %></option>
                                <option value="collections"><%- lang('community.collections') %></option>
                            </select>
                        </div>
                    </div>
                    <div id="schematicsControls">
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('landing.schematicsSearchLabel') %></span>
                            <div class="schematicsSearchRow">
                                <input id="schematicsSearchInput" type="search" placeholder="<%- lang('landing.schematicsSearchPlaceholder') %>" aria-label="<%- lang('landing.schematicsSearchLabel') %>" spellcheck="false" autocomplete="off"/>
                                <button id="schematicsFilterToggle" type="button" class="schematicsIconButton" aria-label="<%- lang('community.filters') %>">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                            <div class="schematicsControlGroup">
                                <span class="schematicsControlLabel"><%- lang('landing.schematicsSortLabel') %></span>
                                <select id="schematicsSortSelect" aria-label="<%- lang('landing.schematicsSortLabel') %>">
                                    <option value="likes-desc"><%- lang('landing.schematicsSortLikesDesc') %></option>
                                    <option value="likes-asc"><%- lang('landing.schematicsSortLikesAsc') %></option>
                                    <option value="release-desc"><%- lang('landing.schematicsSortReleaseDesc') %></option>
                                    <option value="release-asc"><%- lang('landing.schematicsSortReleaseAsc') %></option>
                                </select>
                            </div>
                        <div id="schematicsFiltersPanel" class="schematicsFiltersPanel" hidden>
                            <div class="schematicsFiltersHeader">
                                <span class="schematicsFiltersTitle"><%- lang('community.filters') %></span>
                                <button id="schematicsFiltersClose" type="button" class="schematicsMiniButton"><%- lang('community.close') %></button>
                            </div>
                            <div class="schematicsFiltersBody">
                                <label class="schematicsFilterField">
                                    <span><%- lang('community.tags') %></span>
                                    <input id="schematicsTagsInput" type="text" placeholder="<%- lang('community.tagsPlaceholder') %>" aria-label="<%- lang('community.tagFilter') %>" spellcheck="false" autocomplete="off"/>
                                </label>
                                <label class="schematicsFilterField">
                                    <span><%- lang('community.creator') %></span>
                                    <input id="schematicsCreatorInput" type="text" placeholder="<%- lang('community.creatorPlaceholder') %>" aria-label="<%- lang('community.creatorFilter') %>" spellcheck="false" autocomplete="off"/>
                                </label>
                                <label class="schematicsFilterField schematicsFilterToggle">
                                    <span><%- lang('community.installedOnly') %></span>
                                    <input id="schematicsInstalledToggle" type="checkbox" />
                                </label>
                                <label class="schematicsFilterField schematicsFilterToggle">
                                    <span><%- lang('community.myUploads') %></span>
                                    <input id="schematicsMineToggle" type="checkbox" />
                                </label>
                            </div>
                        </div>
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('landing.schematicsManageLabel') %></span>
                            <button id="schematicsManageInstalledButton" type="button" class="schematicsMiniButton"><%- lang('community.manage') %></button>
                        </div>
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('community.upload') %></span>
                            <button id="schematicsUploadButton" type="button" class="schematicsMiniButton primary"><%- lang('community.uploadSchematic') %></button>
                        </div>
                        <div id="schematicsAdminControlGroup" class="schematicsControlGroup" hidden>
                            <span class="schematicsControlLabel"><%- lang('community.admin') %></span>
                            <button id="schematicsAdminToolsButton" type="button" class="schematicsMiniButton"><%- lang('community.thumbnailTools') %></button>
                        </div>
                    </div>
                    <div id="schematicsCollectionsControls">
                        <div class="schematicsControlGroup schematicsControlMeta">
                            <span class="schematicsControlLabel"><%- lang('community.collections') %></span>
                            <span id="schematicsCollectionsBrowseCount" class="schematicsMetaValue">0</span>
                        </div>
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('community.search') %></span>
                            <div class="schematicsSearchRow">
                                <input id="schematicsCollectionsSearchInput" type="search" placeholder="<%- lang('community.searchCollections') %>" aria-label="<%- lang('community.searchCollections') %>" spellcheck="false" autocomplete="off"/>
                                <button id="schematicsCollectionsFilterToggle" type="button" class="schematicsIconButton" aria-label="<%- lang('community.collectionFilters') %>">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('community.sort') %></span>
                            <select id="schematicsCollectionsSortSelect" aria-label="<%- lang('community.sortCollections') %>">
                                <option value="updated"><%- lang('community.recentlyUpdated') %></option>
                                <option value="items"><%- lang('community.mostSchematics') %></option>
                                <option value="name"><%- lang('community.name') %></option>
                            </select>
                        </div>
                        <div id="schematicsCollectionsFiltersPanel" class="schematicsFiltersPanel" hidden>
                            <div class="schematicsFiltersHeader">
                                <span class="schematicsFiltersTitle"><%- lang('community.filters') %></span>
                                <button id="schematicsCollectionsFiltersClose" type="button" class="schematicsMiniButton"><%- lang('community.close') %></button>
                            </div>
                            <div class="schematicsFiltersBody">
                                <label class="schematicsFilterField">
                                    <span><%- lang('community.creator') %></span>
                                    <input id="schematicsCollectionsCreatorInput" type="text" placeholder="<%- lang('community.creatorPlaceholder') %>" aria-label="<%- lang('community.collectionCreatorFilter') %>" spellcheck="false" autocomplete="off"/>
                                </label>
                                <label class="schematicsFilterField schematicsFilterToggle">
                                    <span><%- lang('community.myCollections') %></span>
                                    <input id="schematicsCollectionsMineToggle" type="checkbox" />
                                </label>
                            </div>
                        </div>
                        <div class="schematicsControlGroup">
                            <span class="schematicsControlLabel"><%- lang('community.create') %></span>
                            <button id="schematicsCollectionsCreateButton" type="button" class="schematicsMiniButton primary"><%- lang('community.newCollection') %></button>
                        </div>
                    </div>
                </div>
            </div>
            <div id="schematicsBrowseSchematicsView" role="tabpanel">
                <div id="schematicsScroll">
                    <div id="schematicsGrid" role="list"></div>
                </div>
                <div class="schematicsPagerBottom">
                    <div class="schematicsPagerControls">
                        <button id="schematicsPagePrev" type="button" class="schematicsMiniButton"><%- lang('community.previous') %></button>
                        <span id="schematicsPageStatus" class="schematicsPagerStatus">1 / 1</span>
                        <button id="schematicsPageNext" type="button" class="schematicsMiniButton"><%- lang('community.next') %></button>
                    </div>
                </div>
            </div>
            <div id="schematicsBrowseCollectionsView" role="tabpanel" hidden>
                <div id="schematicsCollectionsBrowseList" class="schematicsCollectionsBrowseList" role="list"></div>
                <div class="schematicsPagerBottom">
                    <div class="schematicsPagerControls">
                        <button id="schematicsCollectionsPagePrev" type="button" class="schematicsMiniButton"><%- lang('community.previous') %></button>
                        <span id="schematicsCollectionsPageStatus" class="schematicsPagerStatus">1 / 1</span>
                        <button id="schematicsCollectionsPageNext" type="button" class="schematicsMiniButton"><%- lang('community.next') %></button>
                    </div>
                </div>
            </div>
            <div id="schematicsCreatorsBrowseView" role="tabpanel" hidden>
                <div id="schematicsCreatorsGrid" class="schematicsCreatorGrid" role="list"></div>
            </div>
            <div id="schematicsBrowseCreatorView" role="tabpanel" hidden>
                <div class="schematicsCreatorHeader">
                    <div class="schematicsCreatorProfile">
                        <div id="schematicsCreatorAvatar" class="schematicsCreatorAvatar">C</div>
                        <div class="schematicsCreatorHeading">
                            <div class="schematicsCreatorEyebrow"><%- lang('community.creator') %></div>
                            <h2 id="schematicsCreatorTitle"><%- lang('community.creator') %></h2>
                            <div id="schematicsCreatorCount"><%- lang('community.creationsCount') %></div>
                        </div>
                    </div>
                    <div class="schematicsCreatorActions">
                        <div class="schematicsCreatorControl">
                            <span class="schematicsControlLabel"><%- lang('community.sort') %></span>
                            <select id="schematicsCreatorSort" aria-label="<%- lang('community.creatorSortLabel') %>">
                                <option value="likes-desc"><%- lang('landing.schematicsSortLikesDesc') %></option>
                                <option value="likes-asc"><%- lang('landing.schematicsSortLikesAsc') %></option>
                                <option value="release-desc"><%- lang('landing.schematicsSortReleaseDesc') %></option>
                                <option value="release-asc"><%- lang('landing.schematicsSortReleaseAsc') %></option>
                                <option value="name-asc"><%- lang('community.sortNameAsc') %></option>
                                <option value="name-desc"><%- lang('community.sortNameDesc') %></option>
                            </select>
                        </div>
                        <div class="schematicsCreatorControl schematicsPager">
                            <span class="schematicsControlLabel"><%- lang('community.page') %></span>
                            <div class="schematicsPagerControls">
                                <button id="schematicsCreatorPagePrev" type="button" class="schematicsMiniButton"><%- lang('community.previous') %></button>
                                <span id="schematicsCreatorPageStatus" class="schematicsPagerStatus">1 / 1</span>
                                <button id="schematicsCreatorPageNext" type="button" class="schematicsMiniButton"><%- lang('community.next') %></button>
                            </div>
                        </div>
                        <button id="schematicsCreatorClose" type="button" class="schematicsDetailButton"><%- lang('community.back') %></button>
                    </div>
                </div>
                <div id="schematicsCreatorCollections" class="schematicsCreatorCollections" aria-label="<%- lang('community.creatorCollections') %>">
                    <div class="schematicsCreatorCollectionsHeader">
                        <span><%- lang('community.collections') %></span>
                    </div>
                    <div id="schematicsCreatorCollectionsList" class="schematicsCreatorCollectionsList"></div>
                </div>
                <div id="schematicsCreatorGrid" class="schematicsCreatorGrid" role="list"></div>
            </div>
            <%- include('community/modals/detail.ejs') %>
            <%- include('community/modals/admin-tools.ejs') %>
            <%- include('community/modals/collections-browse-detail.ejs') %>
            <div id="schematicsCollectionsPanel" aria-hidden="true">
                <div id="schematicsCollectionsScrim"></div>
                <div id="schematicsCollectionsCard" role="dialog" aria-modal="true" aria-labelledby="schematicsCollectionsTitle">
                    <div class="schematicsCollectionsHeader">
                        <div class="schematicsCollectionsHeading">
                            <div class="schematicsCollectionsEyebrow"><%- lang('community.collections') %></div>
                            <h2 id="schematicsCollectionsTitle"><%- lang('community.schematicCollections') %></h2>
                            <div id="schematicsCollectionsCount"><%- lang('community.collectionsCount') %></div>
                        </div>
                        <div class="schematicsCollectionsActions">
                            <div class="schematicsCollectionsTabs">
                                <button id="schematicsCollectionsTabPublic" type="button" class="schematicsMiniButton"><%- lang('community.public') %></button>
                                <button id="schematicsCollectionsTabMine" type="button" class="schematicsMiniButton"><%- lang('community.myCollections') %></button>
                            </div>
                            <button id="schematicsCollectionsNew" type="button" class="schematicsDetailButton"><%- lang('community.newCollection') %></button>
                            <button id="schematicsCollectionsClose" type="button" class="schematicsDetailButton"><%- lang('community.close') %></button>
                        </div>
                    </div>
                    <div id="schematicsCollectionsCreate" class="schematicsCollectionsCreate" hidden>
                        <div class="schematicsDetailEditRow">
                            <label for="schematicsCollectionsName"><%- lang('community.name') %></label>
                            <input id="schematicsCollectionsName" type="text" maxlength="80" />
                        </div>
                        <div class="schematicsDetailEditRow">
                            <label for="schematicsCollectionsDescription"><%- lang('community.description') %></label>
                            <textarea id="schematicsCollectionsDescription" rows="3" maxlength="800"></textarea>
                        </div>
                        <div class="schematicsDetailEditRow">
                            <label for="schematicsCollectionsVisibility"><%- lang('community.visibility') %></label>
                            <select id="schematicsCollectionsVisibility">
                                <option value="public"><%- lang('community.public') %></option>
                                <option value="unlisted"><%- lang('community.unlisted') %></option>
                                <option value="private"><%- lang('community.private') %></option>
                            </select>
                        </div>
                        <div class="schematicsDetailEditActions">
                            <button id="schematicsCollectionsCreateSave" type="button" class="schematicsDetailButton primary"><%- lang('community.create') %></button>
                            <button id="schematicsCollectionsCreateCancel" type="button" class="schematicsDetailButton"><%- lang('community.cancel') %></button>
                        </div>
                    </div>
                    <div id="schematicsCollectionsList" class="schematicsCollectionsList" role="list"></div>
                    <div id="schematicsCollectionsDetail" class="schematicsCollectionsDetail" hidden>
                        <div class="schematicsCollectionsDetailHeader">
                            <div class="schematicsCollectionsDetailHeading">
                                <h3 id="schematicsCollectionsDetailTitle"><%- lang('community.collection') %></h3>
                                <div id="schematicsCollectionsDetailMeta"><%- lang('community.schematicsCount') %></div>
                            </div>
                            <div class="schematicsCollectionsDetailActions">
                                <button id="schematicsCollectionsDetailBack" type="button" class="schematicsMiniButton"><%- lang('community.back') %></button>
                                <button id="schematicsCollectionsDetailDelete" type="button" class="schematicsMiniButton"><%- lang('community.delete') %></button>
                            </div>
                        </div>
                        <div id="schematicsCollectionsDetailGrid" class="schematicsCreatorGrid" role="list"></div>
                    </div>
                </div>
            </div>
            <%- include('community/modals/upload.ejs') %>
            <%- include('community/modals/edit.ejs') %>
        </div>
    </div>
