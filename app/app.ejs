<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/startup-presentation.js"></script>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/visual-overhaul.css">
    <style>
        body {
            transition: background-color 160ms ease;
            background-image: url('data:image/jpeg;base64,');
            background-size: 0 0;
            background-color: #111817;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: transparent;
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <div id="appShell" hidden>
            <%- include('partials/shell/navigation') %>
            <main id="appShellViewport" tabindex="-1">
                <%- include('settings') %>
                <%- include('landing') %>
            </main>
        </div>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer" data-startup-state="intro" role="status" aria-live="polite">
        <div id="loadingContent" class="startupPanel">
            <img id="startupIntroImage" class="startupBrandAnimation" src="assets/brand/allegator-games-intro.svg" alt="Allegator Games">
            <img id="startupLoopImage" class="startupBrandAnimation" data-src="assets/brand/allegator-games-loading-chomp.svg" alt="" aria-hidden="true">
            <img id="startupStaticImage" src="assets/brand/allegator-games-mark.svg" alt="Allegator Games">
            <div id="startupCopy">
                <span id="startupEyebrow"><%- lang('startup.eyebrow') %></span>
                <span id="startupStatus"
                    data-intro="<%- lang('startup.intro') %>"
                    data-distribution="<%- lang('startup.distribution') %>"
                    data-account="<%- lang('startup.account') %>"
                    data-ready="<%- lang('startup.ready') %>"
                    data-fatal="<%- lang('startup.fatal') %>"><%- lang('startup.intro') %></span>
            </div>
            <button id="startupSkip" type="button"><%- lang('startup.skip') %></button>
            <div id="startupFatalActions" hidden>
                <button id="startupRetry" type="button"><%- lang('startup.retry') %></button>
                <button id="startupClose" type="button"><%- lang('startup.close') %></button>
            </div>
        </div>
    </div>
</body>
</html>
