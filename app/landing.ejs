<div id="landingContainer" style="display: none;" data-shell-route="home">
    <div id="topActions" class="legacyRouteActions" aria-hidden="true">
        <button id="newsButton" type="button" tabindex="-1"><%- lang('landing.newsButton') %></button>
        <button id="schematicsButton" type="button" tabindex="-1"><%- lang('landing.schematicsButton') %></button>
    </div>

    <section id="upper" class="shellRouteView homeWorkspace" aria-labelledby="homeTitle">
        <div id="left" class="homeHeroPanel workshopPanel">
            <span class="workshopEyebrow"><%- lang('home.eyebrow') %></span>
            <h1 id="homeTitle"><%- lang('home.title') %></h1>
            <p><%- lang('home.subtitle') %></p>
            <div class="homeBrandRule" aria-hidden="true"><span></span><span></span><span></span></div>
            <div class="homeHeroStatus">
                <span class="statusRune" aria-hidden="true"></span>
                <div>
                    <small><%- lang('home.channelLabel') %></small>
                    <strong id="homeChannelValue"><%- lang('home.channelLoading') %></strong>
                </div>
            </div>
        </div>

        <div id="content" class="homeDashboard">
            <article class="workshopPanel homePackCard">
                <header class="panelHeader">
                    <div>
                        <span class="workshopEyebrow"><%- lang('home.selectedPack') %></span>
                        <h2 id="homeProfileName"><%- lang('home.loadingProfile') %></h2>
                    </div>
                    <span class="itemSlot" aria-hidden="true">
                        <img src="assets/brand/allegator-games-mark.svg" alt="">
                    </span>
                </header>
                <p id="homeProfileDescription"><%- lang('home.profileDescription') %></p>
                <dl class="homeStatsGrid">
                    <div><dt><%- lang('home.packVersion') %></dt><dd id="homeProfileVersion">—</dd></div>
                    <div><dt><%- lang('home.minecraftVersion') %></dt><dd id="homeMinecraftVersion">—</dd></div>
                    <div><dt><%- lang('home.loader') %></dt><dd id="homeLoaderVersion">NeoForge</dd></div>
                    <div><dt><%- lang('home.optionalMods') %></dt><dd id="homeOptionalMods">—</dd></div>
                </dl>
            </article>

            <article class="workshopPanel homeActivityCard">
                <header class="panelHeader compact">
                    <div>
                        <span class="workshopEyebrow"><%- lang('home.realmStatus') %></span>
                        <h2><%- lang('home.readyToPlay') %></h2>
                    </div>
                    <span class="panelChip"><%- lang('home.java21') %></span>
                </header>
                <div id="server_status_wrapper" class="homeStatusLine">
                    <span class="statusRune" aria-hidden="true"></span>
                    <div>
                        <small id="landingPlayerLabel"><%- lang('landing.serverStatus') %></small>
                        <strong id="player_count"><%- lang('landing.serverStatusPlaceholder') %></strong>
                    </div>
                </div>
                <p><%- lang('home.manualConnection') %></p>
            </article>
        </div>

        <div id="right" class="homeSidePanel workshopPanel">
            <span class="workshopEyebrow"><%- lang('home.workshopNotes') %></span>
            <h2><%- lang('home.communityCalloutTitle') %></h2>
            <p><%- lang('home.communityCalloutBody') %></p>
            <button id="homeCommunityButton" type="button" class="workshopButton secondary"><%- lang('home.openCommunity') %></button>
            <div class="engravedDivider" aria-hidden="true"></div>
            <span class="workshopEyebrow"><%- lang('home.quickTip') %></span>
            <p class="smallCopy"><%- lang('home.quickTipBody') %></p>
        </div>
    </section>

    <section id="communityHub" class="shellRouteView communityHub" aria-labelledby="communityHubTitle" hidden>
        <header class="routeHeader">
            <div>
                <span class="workshopEyebrow"><%- lang('community.eyebrow') %></span>
                <h1 id="communityHubTitle"><%- lang('community.title') %></h1>
                <p><%- lang('community.subtitle') %></p>
            </div>
            <span id="communityConnectionState" class="panelChip"><%- lang('community.checking') %></span>
        </header>
        <div id="communityModuleGrid" class="communityModuleGrid" role="list" aria-live="polite"></div>
        <div id="communityHubEmpty" class="workshopEmptyState" hidden>
            <img src="assets/brand/allegator-games-mark.svg" alt="">
            <h2><%- lang('community.emptyTitle') %></h2>
            <p><%- lang('community.emptyBody') %></p>
        </div>
    </section>

    <div id="lower" class="globalLaunchDock" aria-label="<%- lang('home.launchDockLabel') %>">
        <div id="left" class="launchDockStatus">
            <span class="workshopEyebrow"><%- lang('home.selectedProfile') %></span>
            <button id="server_selection_button" class="launchProfileButton" type="button"><%- lang('landing.launchButtonPlaceholder') %></button>
        </div>
        <div id="center" class="launchDockMessage">
            <div id="content"><span><%- lang('home.launchHint') %></span></div>
        </div>
        <div id="right" class="launchDockAction">
            <div id="launch_content">
                <button id="launch_button" type="button"><span><%- lang('landing.launchButton') %></span></button>
            </div>
            <div id="launch_details">
                <div id="launch_details_left"><span id="launch_progress_label">0%</span></div>
                <div id="launch_details_right">
                    <progress id="launch_progress" value="0" max="100"></progress>
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                </div>
            </div>
        </div>
    </div>

    <%- include('partials/landing/news.ejs') %>
    <%- include('partials/landing/community.ejs') %>
</div>
<%- include('partials/landing/installed.ejs') %>
<script src="./assets/js/scripts/landing/modals.js" defer></script>
<script src="./assets/js/scripts/landing/schematics/dom.js" defer></script>
<script src="./assets/js/scripts/community-modules.js" defer></script>
<script src="./assets/js/scripts/landing.js" defer></script>
<script src="./assets/js/scripts/shell.js" defer></script>
