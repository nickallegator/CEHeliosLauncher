# Server
PORT=8080
BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
TRUST_PROXY=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cehelios

# Session
SESSION_TTL_DAYS=30

# Authenticated Cobble Power releases (private R2 bucket)
RELEASES_ENABLED=true
RELEASES_CHANNEL=test
RELEASES_REQUIRED_ENTITLEMENT=cobblepower:test
RELEASES_STORAGE_PROVIDER=r2
RELEASES_STORAGE_BUCKET=cobblepower-releases
RELEASES_STORAGE_REGION=auto
RELEASES_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RELEASES_STORAGE_ACCESS_KEY_ID=
RELEASES_STORAGE_SECRET_ACCESS_KEY=
RELEASES_STORAGE_FORCE_PATH_STYLE=false
RELEASES_STORAGE_GET_TTL_SECONDS=3600

# Public schematic-service discovery injected into authorized launcher distributions.
# Set this only on the release API service; it does not grant storage access.
SCHEMATICS_PUBLIC_API_URL=https://cobblepower-schematics-api.onrender.com

# Keep disabled in the release-only deployment until schematics is ready.
SCHEMATICS_ENABLED=false
SCHEMATICS_WRITE_MODE=admin
SCHEMATICS_COLLECTIONS_ENABLED=false
SCHEMATICS_CREATORS_ENABLED=false
SCHEMATICS_DEVELOPMENT_SEEDS=false
SCHEMATICS_UPLOADS_PER_HOUR=10
SCHEMATICS_REPORTS_PER_DAY=10
SCHEMATICS_STORAGE_DIR=

# Schematics object storage (S3/R2/MinIO)
SCHEMATICS_STORAGE_PROVIDER=r2
SCHEMATICS_STORAGE_BUCKET=
SCHEMATICS_STORAGE_REGION=auto
SCHEMATICS_STORAGE_ENDPOINT=
SCHEMATICS_STORAGE_ACCESS_KEY_ID=
SCHEMATICS_STORAGE_SECRET_ACCESS_KEY=
SCHEMATICS_STORAGE_FORCE_PATH_STYLE=false
SCHEMATICS_STORAGE_PUT_TTL_SECONDS=900
SCHEMATICS_STORAGE_GET_TTL_SECONDS=900

# Optional integrity scan flags
SCHEMATICS_INTEGRITY_VERIFY_HASH=false
SCHEMATICS_INTEGRITY_QUARANTINE_INVALID=false
SCHEMATICS_INTEGRITY_LIMIT=500
SCHEMATICS_INTEGRITY_OFFSET=0

# Unified Community content. COMMUNITY_STORAGE_* is preferred; each value falls
# back to its matching SCHEMATICS_STORAGE_* value during the shared-bucket rollout.
COMMUNITY_ENABLED=false
COMMUNITY_RICH_PREVIEWS_ENABLED=false
COMMUNITY_PACK_STUDIO_ENABLED=false
COMMUNITY_MODRINTH_ENABLED=false
MODRINTH_CLIENT_ID=
MODRINTH_CLIENT_SECRET=
MODRINTH_REDIRECT_URI=https://cobblepower-schematics-api.onrender.com/v1/integrations/modrinth/oauth/callback
MODRINTH_OAUTH_SCOPES=USER_READ PROJECT_READ
MODRINTH_API_BASE=https://api.modrinth.com
MODRINTH_USER_AGENT=AGLauncher/2.6 (contact: support@allegator.games)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EXTERNAL_TOKEN_ENCRYPTION_KEY=
EXTERNAL_TOKEN_ENCRYPTION_KEY_ID=v1
MODRINTH_SYNC_CONCURRENCY=4
COMMUNITY_PUBLIC_API_URL=https://cobblepower-schematics-api.onrender.com
COMMUNITY_WRITE_MODE=admin
COMMUNITY_AUTOMATION_ENABLED=false
COMMUNITY_BATTLE_TRAINERS_ENABLED=false
COMMUNITY_BUILDER_PRESETS_ENABLED=false
COMMUNITY_RESOURCE_PACKS_ENABLED=false
COMMUNITY_UPLOADS_PER_HOUR=10
COMMUNITY_REPORTS_PER_DAY=10
COMMUNITY_COMPOSER_RESOLVES_PER_HOUR=120
COMMUNITY_ALLOWED_LICENSES=Community-Use-1.0,CC0-1.0,CC-BY-4.0,CC-BY-SA-4.0,MIT
COMMUNITY_STORAGE_PROVIDER=r2
COMMUNITY_STORAGE_BUCKET=
COMMUNITY_STORAGE_REGION=auto
COMMUNITY_STORAGE_ENDPOINT=
COMMUNITY_STORAGE_ACCESS_KEY_ID=
COMMUNITY_STORAGE_SECRET_ACCESS_KEY=
COMMUNITY_STORAGE_FORCE_PATH_STYLE=false
COMMUNITY_STORAGE_PUT_TTL_SECONDS=900
COMMUNITY_STORAGE_GET_TTL_SECONDS=900

# Patreon OAuth (required for auth routes)
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_REDIRECT_URI=http://localhost:8080/auth/patreon/callback
PATREON_SCOPES=identity identity.memberships
PATREON_CAMPAIGN_ID=
PATREON_CREATOR_USER_ID=

# Optional Patreon endpoint overrides
PATREON_AUTHORIZE_URL=https://www.patreon.com/oauth2/authorize
PATREON_TOKEN_URL=https://www.patreon.com/api/oauth2/token
PATREON_API_BASE=https://www.patreon.com/api/oauth2/v2

# Tier mapping: tierId=entitlement,tierId2=entitlement2
PATREON_TIER_MAP=
# Fallback entitlement when no tier mapping exists and patron is active
PATREON_DEFAULT_ENTITLEMENT=patreon:subscriber
